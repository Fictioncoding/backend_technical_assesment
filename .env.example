# Application Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_RETURN_URL=http://localhost:3000/api/payments/orders/{order_id}

# Cashfree Payment Gateway Configuration
# Get your Sandbox API keys from https://merchant.cashfree.com/merchants/login
CASHFREE_APP_ID=YOUR_CASHFREE_APP_ID
CASHFREE_SECRET_KEY=YOUR_CASHFREE_SECRET_KEY
CASHFREE_API_VERSION=2023-08-01
CASHFREE_ENVIRONMENT=SANDBOX
# Set CASHFREE_MOCK_MODE=false when you provide real Cashfree Sandbox credentials
CASHFREE_MOCK_MODE=true
CASHFREE_WEBHOOK_SECRET=test_webhook_secret_key

# Database Configuration (PostgreSQL or SQLite)
# Set DB_TYPE=postgres for PostgreSQL, or DB_TYPE=sqlite for zero-config embedded testing
DB_TYPE=sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ums_cashfree_db
DB_SYNCHRONIZE=true
SQLITE_DB_PATH=./data/payments.sqlite
